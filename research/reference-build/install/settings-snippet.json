{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Monitor",
        "hooks": [
          { "type": "command", "command": "__NODE__", "args": ["__HOME__/.claude/hooks/jev/hooks/brake.cjs"], "timeout": 6 }
        ]
      },
      {
        "matcher": "Workflow|Agent",
        "hooks": [
          { "type": "command", "command": "__NODE__", "args": ["__HOME__/.claude/hooks/jev/hooks/nudge.cjs"], "timeout": 3 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "WebFetch|WebSearch",
        "hooks": [
          { "type": "command", "command": "__NODE__", "args": ["__HOME__/.claude/hooks/jev/hooks/webscreen.cjs"], "timeout": 8, "async": true }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "if": "Bash(curl *)",          "type": "command", "command": "__NODE__", "args": ["__HOME__/.claude/hooks/jev/hooks/webscreen.cjs"], "timeout": 8, "async": true },
          { "if": "Bash(wget *)",          "type": "command", "command": "__NODE__", "args": ["__HOME__/.claude/hooks/jev/hooks/webscreen.cjs"], "timeout": 8, "async": true },
          { "if": "Bash(gh api *)",        "type": "command", "command": "__NODE__", "args": ["__HOME__/.claude/hooks/jev/hooks/webscreen.cjs"], "timeout": 8, "async": true },
          { "if": "Bash(gh issue view *)", "type": "command", "command": "__NODE__", "args": ["__HOME__/.claude/hooks/jev/hooks/webscreen.cjs"], "timeout": 8, "async": true },
          { "if": "Bash(gh pr view *)",    "type": "command", "command": "__NODE__", "args": ["__HOME__/.claude/hooks/jev/hooks/webscreen.cjs"], "timeout": 8, "async": true },
          { "if": "Bash(gh repo view *)",  "type": "command", "command": "__NODE__", "args": ["__HOME__/.claude/hooks/jev/hooks/webscreen.cjs"], "timeout": 8, "async": true },
          { "if": "Bash(gh search *)",     "type": "command", "command": "__NODE__", "args": ["__HOME__/.claude/hooks/jev/hooks/webscreen.cjs"], "timeout": 8, "async": true }
        ]
      },
      {
        "matcher": "Grep|Glob|Bash",
        "hooks": [
          { "type": "command", "command": "__NODE__", "args": ["__HOME__/.claude/hooks/jev/hooks/nudge.cjs"], "timeout": 3 }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(~/.config/jev/**)",
      "Edit(~/.config/jev/**)",
      "Edit(~/.claude/hooks/**)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/.claude/settings.local.json)",
      "Edit(~/.local/state/jev/**)",
      "Bash(git push --force*)", "Bash(git push -f *)", "Bash(git push * --force*)",
      "Bash(gh repo delete*)", "Bash(gh repo archive*)", "Bash(git clean -fdx*)",
      "Bash(git filter-branch*)", "Bash(git reflog expire*)", "Bash(terraform destroy*)",
      "Bash(crontab -r*)", "Bash(dd * of=/dev/*)", "Bash(mkfs*)"
    ]
  }
}
